{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.craisinlord.anthology.fabric.AnthologyFabric"
    ],
    "client": [
      "com.craisinlord.anthology.fabric.client.AnthologyFabricClient"
    ]
  },
  "mixins": [
    "anthology-common.mixins.json",
    "anthology-fabric.mixins.json",
    "anthology-sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
